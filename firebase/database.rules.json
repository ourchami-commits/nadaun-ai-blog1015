{
  "rules": {
    "admins": {
      ".read": false,
      ".write": false,
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "decks": {
      "$deck": {
        "state": {
          ".read": true,
          ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
          ".validate": "newData.hasChildren(['slide', 'locked', 'pdf'])",
          "slide": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 1000" },
          "locked": { ".validate": "newData.isBoolean()" },
          "pdf": { ".validate": "newData.isBoolean()" },
          "timer": {
            ".validate": "newData.hasChildren(['id', 'running', 'remaining', 'endAt'])",
            "id": { ".validate": "newData.isString() && newData.val().length <= 12" },
            "running": { ".validate": "newData.isBoolean()" },
            "remaining": { ".validate": "newData.isNumber() && newData.val() >= -86400 && newData.val() <= 86400" },
            "endAt": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "$other": { ".validate": false }
          },
          "updatedAt": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        },
        "viewers": {
          ".read": true,
          "$vid": {
            ".write": "$vid.length <= 30",
            ".validate": "newData.isNumber()"
          }
        }
      }
    }
  }
}
